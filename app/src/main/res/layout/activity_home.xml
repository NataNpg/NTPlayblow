<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_app" android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/logo_icon" android:contentDescription="NTPlayblow"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NTPlayblow" android:textColor="#CED9DE" android:textSize="24sp"
            android:textStyle="bold" android:paddingStart="10dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="HH:mm" android:format12Hour="HH:mm"
                android:textColor="#E6EDF2" android:textSize="34sp"/>
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="EEEE, d 'de' MMMM" android:format12Hour="EEEE, d 'de' MMMM"
                android:textColor="#7F8E99" android:textSize="13sp"/>
        </LinearLayout>
        <Button android:id="@+id/settings" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚙ Configurações" android:textAllCaps="false"/>
        <Button android:id="@+id/profile" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Perfil" android:textAllCaps="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:layout_marginTop="12dp">

        <LinearLayout android:id="@+id/tile_live"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="72dp" android:layout_height="72dp"
                android:src="@drawable/ic_live" android:contentDescription="TV ao Vivo"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TV ao Vivo" android:textColor="#E6EDF2" android:textSize="26sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <LinearLayout android:id="@+id/tile_movies"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2"
                android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:src="@drawable/ic_movies" android:contentDescription="Filmes"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Filmes" android:textColor="#E6EDF2" android:textSize="24sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_favs"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_tile"
                android:layout_marginTop="12dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_heart" android:contentDescription="Favoritos"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Favoritos" android:textColor="#E6EDF2" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/sub_favs" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#7F8E99" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <LinearLayout android:id="@+id/tile_series"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2"
                android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_tile"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="56dp" android:layout_height="56dp"
                    android:src="@drawable/ic_series" android:contentDescription="Séries"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Séries" android:textColor="#E6EDF2" android:textSize="24sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tile_playlist"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_tile"
                android:layout_marginTop="12dp" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_playlist" android:contentDescription="Playlist"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Playlist" android:textColor="#E6EDF2" android:textSize="20sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Adicionar / gerenciar" android:textColor="#7F8E99" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#7F8E99" android:textSize="13sp"
        android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>
