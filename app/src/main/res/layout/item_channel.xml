<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_item" android:padding="10dp">
    <TextView android:id="@+id/num" android:layout_width="48dp" android:layout_height="wrap_content"
        android:textColor="#7F8E99" android:textSize="12sp"/>
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textColor="#E6EDF2" android:textSize="15sp"
        android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/heart" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:padding="8dp" android:textSize="20sp" android:textColor="#4DD0E1"
        android:clickable="true" android:focusable="false"/>
</LinearLayout>
